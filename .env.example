ANTHROPIC_API_KEY=your_key_here
SUPABASE_URL=your_url_here
SUPABASE_KEY=your_key_here

# KIS API (모의/실거래 별도 앱 등록 필요)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_IS_MOCK=true   # true=모의 / false=실거래 (실거래 시 별도 앱 키 필요)

# 실계좌 안전장치 (KIS_IS_MOCK=false 시 권장)
# 주문 한도 — 코드 변경 없이 .env 한 줄 수정 + PM2 restart로 반영
ORDER_MAX_PER_TRADE=1000000      # 주문당 최대 (원, default ₩1M)
ORDER_MAX_DAILY_TOTAL=5000000    # 일별 BUY 총액 최대 (원, default ₩5M)

# DRY_RUN — true 시 KIS 주문 API 호출 skip (사고 시 즉시 운영 정지용)
# default=false (env 미설정 = 실 주문). 평소엔 미설정, 사고 시에만 true 토글.
DRY_RUN=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO
